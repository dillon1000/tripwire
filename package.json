{
  "name": "@dillon1000/tripwire",
  "version": "0.1.0",
  "description": "Configurable local safety checks for deploys, pushes, deletes, migrations, and releases.",
  "type": "module",
  "packageManager": "pnpm@11.1.3",
  "bin": {
    "tripwire": "./dist/src/cli.js"
  },
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist/src",
    "README.md",
    "tripwire.schema.json"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "pnpm build && node --test dist/tests/*.test.js",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "keywords": [
    "deploy",
    "safety",
    "git",
    "cli",
    "preflight"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.8.0"
  }
}
